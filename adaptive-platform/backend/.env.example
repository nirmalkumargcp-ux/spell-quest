# Local development uses SQLite so the project runs with no infrastructure.
DATABASE_URL=sqlite:///./adaptive.db

# docker-compose sets this instead:
# DATABASE_URL=postgresql+psycopg://adaptive:adaptive@db:5432/adaptive

ENVIRONMENT=local
DEBUG=true

# Fix this to make adaptive question selection reproducible (spec §42).
# ADAPTIVE_SEED=42

# Where the child app loads photos and audio from.
MEDIA_BASE_URL=/media

# Seed the English curriculum on startup (set 0 in production once seeded).
SEED_ON_START=1
